{
  "name": "studyplan",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "demo:build": "tsc -b && vite build --mode demo",
    "demo:preview": "vite preview --mode demo --host 127.0.0.1 --port 4173",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "test:contracts": "playwright test --config playwright.web.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:ui": "pnpm demo:build && pnpm test:contracts",
    "lan:assets": "tsc -b && vite build --mode lan && node scripts/build-lan.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "ical.js": "^2.2.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
