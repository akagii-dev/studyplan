{
  "name": "studyplan",
  "version": "0.4.20",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "demo:build": "tsc -b && vite build --mode demo",
    "demo:preview": "vite preview --mode demo --host 127.0.0.1 --port 4173",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "test:contracts": "playwright test --config playwright.web.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:ui": "pnpm demo:build && pnpm test:contracts",
    "pwa:build": "tsc -b && vite build --mode pwa && node scripts/build-pwa.mjs",
    "pwa:start": "node scripts/pwa-host.mjs start",
    "pwa:status": "node scripts/pwa-host.mjs status",
    "pwa:stop": "node scripts/pwa-host.mjs stop",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "verify:pwa": "pnpm pwa:build && pnpm demo:build && pnpm test:pwa",
    "pwa:https:start": "node scripts/pwa-host.mjs https-start",
    "pwa:https:status": "node scripts/pwa-host.mjs https-status",
    "pwa:https:stop": "node scripts/pwa-host.mjs https-stop"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "ical.js": "^2.2.1",
    "prettier": "^3.9.8",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
