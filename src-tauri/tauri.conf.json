{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyPlan", "version": "0.11.1", "identifier": "jp.local.studyplan",
  "build": { "beforeDevCommand": "pnpm lan:assets && pnpm dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "pnpm lan:assets && pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "StudyPlan", "visible": false, "width": 1320, "height": 900, "minWidth": 480, "minHeight": 540 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "nsis": { "installMode": "currentUser", "languages": ["Japanese"], "installerIcon": "icons/icon.ico" }
    }
  }
}
